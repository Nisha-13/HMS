{
  "version": 2,
  "builds": [
    {
      "src": "backend/public/index.php",
      "use": "vercel-php"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/public/index.php"
    },
    {
      "source": "/assets/(.*)",
      "destination": "frontend/dist/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/dist/index.html"
    }
  ]
}
