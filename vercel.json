{
  "version": 2,
  "builds": [
    {
      "src": "backend/public/index.php",
      "use": "vercel-php"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "functions": {
    "backend/public/index.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/public/index.php"
    },
    {
      "source": "/run-migrations",
      "destination": "backend/public/index.php"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
